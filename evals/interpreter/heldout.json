{
  "suite": "interpreter",
  "version": 1,
  "split": "heldout",
  "cases": [
    {
      "id": "h001",
      "covers": ["entity"],
      "prompt": "put on Ada Vance",
      "expect": {
        "action": "search",
        "filters": {
          "artists": ["Ada Vance"]
        }
      }
    },
    {
      "id": "h002",
      "covers": ["entity", "genre"],
      "prompt": "Jazz Hands Collective",
      "expect": {
        "action": "search",
        "filters": {
          "artists": ["Jazz Hands Collective"]
        },
        "note": "An artist whose name holds a genre word. genres stays empty."
      }
    },
    {
      "id": "h003",
      "covers": ["entity", "genre"],
      "prompt": "play Rock Bottom",
      "expect": {
        "action": "search",
        "songs": ["s21"],
        "note": "A song title holding a genre word. genres stays empty."
      }
    },
    {
      "id": "h004",
      "covers": ["entity"],
      "prompt": "play Intro by Harbor Static",
      "expect": {
        "action": "search",
        "songs": ["s04"]
      }
    },
    {
      "id": "h005",
      "covers": ["entity", "ambiguous"],
      "prompt": "Delta",
      "expect": {
        "action": "clarify",
        "ambiguous": true,
        "note": "Velvet Delta is an artist and Delta Morning is a song."
      }
    },
    {
      "id": "h006",
      "covers": ["genre"],
      "prompt": "some liquid",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["liquid drum and bass|liquid dnb|liquid"]
        }
      }
    },
    {
      "id": "h007",
      "covers": ["genre"],
      "prompt": "drum & bass",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["drum and bass|dnb|drum & bass|drum n bass"]
        }
      }
    },
    {
      "id": "h008",
      "covers": ["genre"],
      "prompt": "trip hop",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["trip-hop|trip hop"]
        }
      }
    },
    {
      "id": "h009",
      "covers": ["genre"],
      "prompt": "liquid or neurofunk",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["liquid drum and bass|liquid dnb|liquid", "neurofunk"]
        }
      }
    },
    {
      "id": "h010",
      "covers": ["duration", "boundary"],
      "prompt": "less than an hour",
      "expect": {
        "action": "search",
        "filters": {
          "total_length": {
            "mode": "under",
            "seconds": 3600
          }
        }
      }
    },
    {
      "id": "h011",
      "covers": ["duration"],
      "prompt": "an hour, give or take",
      "expect": {
        "action": "search",
        "filters": {
          "total_length": {
            "mode": "about",
            "seconds": 3600
          }
        }
      }
    },
    {
      "id": "h012",
      "covers": ["duration", "boundary"],
      "prompt": "90 minutes max",
      "expect": {
        "action": "search",
        "filters": {
          "total_length": {
            "mode": "at_most",
            "seconds": 5400
          }
        }
      }
    },
    {
      "id": "h013",
      "covers": ["duration", "boundary", "genre"],
      "prompt": "more than an hour of jazz",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["jazz"],
          "total_length": {
            "mode": "over",
            "seconds": 3600
          }
        }
      }
    },
    {
      "id": "h014",
      "covers": ["duration", "boundary"],
      "prompt": "a good two hours, at minimum",
      "expect": {
        "action": "search",
        "filters": {
          "total_length": {
            "mode": "at_least",
            "seconds": 7200
          }
        }
      }
    },
    {
      "id": "h015",
      "covers": ["duration", "genre"],
      "prompt": "about 25 minutes of grime",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["grime"],
          "total_length": {
            "mode": "about",
            "seconds": 1500
          }
        }
      }
    },
    {
      "id": "h016",
      "covers": ["song-length", "boundary"],
      "prompt": "short songs, under three minutes",
      "expect": {
        "action": "search",
        "filters": {
          "max_seconds": 179
        }
      }
    },
    {
      "id": "h017",
      "covers": ["song-length", "boundary"],
      "prompt": "songs of at least 5 minutes",
      "expect": {
        "action": "search",
        "filters": {
          "min_seconds": 300
        }
      }
    },
    {
      "id": "h018",
      "covers": ["negation", "genre"],
      "prompt": "pop but not Static Bloom",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["pop"],
          "exclude_artists": ["Static Bloom"]
        }
      }
    },
    {
      "id": "h019",
      "covers": ["negation", "genre"],
      "prompt": "no podcasts",
      "expect": {
        "action": "unsupported",
        "note": "There is no genre exclusion, and podcast must not land in genres."
      }
    },
    {
      "id": "h020",
      "covers": ["negation", "history"],
      "prompt": "skip anything I heard this week",
      "expect": {
        "action": "search",
        "filters": {
          "exclude_played_days": 7
        },
        "note": "Skip here means leave out, not the transport command."
      }
    },
    {
      "id": "h021",
      "covers": ["similar"],
      "playing": "s13",
      "prompt": "more in this vein",
      "expect": {
        "action": "search",
        "filters": {
          "similar_to_current": true
        }
      }
    },
    {
      "id": "h022",
      "covers": ["similar", "year"],
      "playing": "s20",
      "prompt": "like this, but from the 60s",
      "expect": {
        "action": "search",
        "filters": {
          "similar_to_current": true,
          "year_from": 1960,
          "year_to": 1969
        }
      }
    },
    {
      "id": "h023",
      "covers": ["similar", "recipes"],
      "playing": "s01",
      "prompt": "same tempo as this",
      "expect": {
        "action": "unsupported",
        "note": "Tempo needs the tempo and energy recipe, which is off here."
      }
    },
    {
      "id": "h024",
      "covers": ["transport"],
      "playing": "s18",
      "prompt": "pause it",
      "expect": {
        "action": "pause"
      }
    },
    {
      "id": "h025",
      "covers": ["transport"],
      "playing": "s18",
      "queue": ["s23", "s12"],
      "prompt": "next",
      "expect": {
        "action": "skip"
      }
    },
    {
      "id": "h026",
      "covers": ["transport"],
      "playing": "s18",
      "paused": true,
      "prompt": "unpause",
      "expect": {
        "action": "resume"
      }
    },
    {
      "id": "h027",
      "covers": ["queue", "entity"],
      "playing": "s05",
      "queue": ["s02", "s11", "s06", "s12", "s24"],
      "prompt": "of what's queued, only Orchard",
      "expect": {
        "action": "search",
        "scope": "queue",
        "filters": {
          "artists": ["Orchard"]
        }
      }
    },
    {
      "id": "h028",
      "covers": ["transport"],
      "playing": "s11",
      "queue": ["s12"],
      "prompt": "go back one song",
      "expect": {
        "action": "unsupported"
      }
    },
    {
      "id": "h029",
      "covers": ["queue", "out-of-scope"],
      "playing": "s11",
      "queue": ["s12", "s02", "s05"],
      "prompt": "shuffle my queue",
      "expect": {
        "action": "unsupported"
      }
    },
    {
      "id": "h030",
      "covers": ["follow-up", "year"],
      "previous": {
        "prompt": "liquid from 2019",
        "scope": "library",
        "filters": {
          "genres": ["liquid"],
          "year_from": 2019,
          "year_to": 2019
        },
        "songs": ["s01", "s04"]
      },
      "prompt": "make it 2020s instead",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["liquid drum and bass|liquid dnb|liquid"],
          "year_from": 2020,
          "year_to": 2029
        },
        "keeps": ["genres"]
      }
    },
    {
      "id": "h031",
      "covers": ["follow-up", "history"],
      "previous": {
        "prompt": "Velvet Delta, nothing from today",
        "scope": "library",
        "filters": {
          "artists": ["Velvet Delta"],
          "exclude_played_days": 1
        },
        "songs": ["s03", "s15"]
      },
      "prompt": "also include today's plays",
      "expect": {
        "action": "search",
        "filters": {
          "artists": ["Velvet Delta"]
        },
        "keeps": ["artists"],
        "note": "exclude_played_days goes back to 0 because the person withdrew it.",
        "drops": ["exclude_played_days"]
      }
    },
    {
      "id": "h032",
      "covers": ["follow-up", "negation"],
      "previous": {
        "prompt": "pop without Static Bloom",
        "scope": "library",
        "filters": {
          "genres": ["pop"],
          "exclude_artists": ["Static Bloom"]
        },
        "songs": ["s25"]
      },
      "prompt": "no Prompt Kid either",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["pop"],
          "exclude_artists": ["Static Bloom", "Prompt Kid"]
        },
        "keeps": ["genres"],
        "note": "Exclusions add up."
      }
    },
    {
      "id": "h033",
      "covers": ["follow-up", "favourites", "duration"],
      "previous": {
        "prompt": "an hour of drum and bass",
        "scope": "library",
        "filters": {
          "genres": ["drum and bass"],
          "total_length": {
            "mode": "about",
            "seconds": 3600
          }
        },
        "songs": ["s05", "s06", "s01", "s24"]
      },
      "prompt": "only my favourites from that",
      "expect": {
        "action": "search",
        "scope": "proposal",
        "filters": {
          "genres": ["drum and bass|dnb|drum & bass|drum n bass"],
          "total_length": {
            "mode": "about",
            "seconds": 3600
          },
          "favourites": true
        },
        "keeps": ["genres", "total_length"]
      }
    },
    {
      "id": "h034",
      "covers": ["follow-up", "duration"],
      "previous": {
        "prompt": "jazz",
        "scope": "library",
        "filters": {
          "genres": ["jazz"]
        },
        "songs": ["s20"]
      },
      "prompt": "and 40 minutes of it",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["jazz"],
          "total_length": {
            "mode": "about",
            "seconds": 2400
          }
        },
        "keeps": ["genres"]
      }
    },
    {
      "id": "h035",
      "covers": ["follow-up", "genre"],
      "previous": {
        "prompt": "60s folk",
        "scope": "library",
        "filters": {
          "genres": ["folk"],
          "year_from": 1960,
          "year_to": 1969
        },
        "songs": ["s22"]
      },
      "prompt": "blues instead of folk",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["blues"],
          "year_from": 1960,
          "year_to": 1969
        },
        "keeps": ["year_from", "year_to"]
      }
    },
    {
      "id": "h036",
      "covers": ["follow-up", "history"],
      "previous": {
        "prompt": "Ada Vance I haven't played",
        "scope": "library",
        "filters": {
          "artists": ["Ada Vance"],
          "history": "unplayed"
        },
        "songs": []
      },
      "prompt": "actually, played ones are fine too",
      "expect": {
        "action": "search",
        "filters": {
          "artists": ["Ada Vance"]
        },
        "keeps": ["artists"],
        "drops": ["history"]
      }
    },
    {
      "id": "h037",
      "covers": ["follow-up", "negation", "year"],
      "previous": {
        "prompt": "hip hop, no Velvet Delta",
        "scope": "library",
        "filters": {
          "genres": ["hip hop"],
          "exclude_artists": ["Velvet Delta"]
        },
        "songs": []
      },
      "prompt": "let Velvet Delta back in, and make it 90s",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["hip hop|hip-hop|rap"],
          "year_from": 1990,
          "year_to": 1999
        },
        "keeps": ["genres"],
        "drops": ["exclude_artists"]
      }
    },
    {
      "id": "h038",
      "covers": ["edit"],
      "previous": {
        "prompt": "pop",
        "scope": "library",
        "filters": {
          "genres": ["pop"]
        },
        "songs": ["s18", "s23", "s25"]
      },
      "prompt": "another batch",
      "expect": {
        "action": "edit",
        "edit": {
          "kind": "another"
        }
      }
    },
    {
      "id": "h039",
      "covers": ["edit", "entity"],
      "previous": {
        "prompt": "Ada Vance",
        "scope": "library",
        "filters": {
          "artists": ["Ada Vance"]
        },
        "songs": ["s16", "s17", "s21"]
      },
      "prompt": "keep Rock Bottom, swap the others",
      "expect": {
        "action": "edit",
        "edit": {
          "kind": "another",
          "pinned": ["s21"]
        }
      }
    },
    {
      "id": "h040",
      "covers": ["edit"],
      "previous": {
        "prompt": "grime",
        "scope": "library",
        "filters": {
          "genres": ["grime"]
        },
        "songs": ["s15"]
      },
      "prompt": "one more song",
      "expect": {
        "action": "edit",
        "edit": {
          "kind": "add",
          "count": 1
        }
      }
    },
    {
      "id": "h041",
      "covers": ["edit", "entity"],
      "previous": {
        "prompt": "Orchard",
        "scope": "library",
        "filters": {
          "artists": ["Orchard"]
        },
        "songs": ["s11", "s02", "s12"]
      },
      "prompt": "lose the second one",
      "expect": {
        "action": "edit",
        "edit": {
          "kind": "remove",
          "ids": ["s02"]
        }
      }
    },
    {
      "id": "h042",
      "covers": ["favourites", "history"],
      "prompt": "favourites I haven't played this month",
      "expect": {
        "action": "search",
        "filters": {
          "favourites": true,
          "exclude_played_days": 30
        },
        "note": "This month is read as the last 30 days, the nearest the contract allows."
      }
    },
    {
      "id": "h043",
      "covers": ["year"],
      "prompt": "the 2000s",
      "expect": {
        "action": "search",
        "filters": {
          "year_from": 2000,
          "year_to": 2009
        }
      }
    },
    {
      "id": "h044",
      "covers": ["count", "history"],
      "prompt": "10 tracks I've played a lot",
      "expect": {
        "action": "search",
        "filters": {
          "limit": 10,
          "history": "familiar"
        }
      }
    },
    {
      "id": "h045",
      "covers": ["mutation-guard"],
      "previous": {
        "prompt": "liquid",
        "scope": "library",
        "filters": {
          "genres": ["liquid"]
        },
        "songs": ["s01", "s04"]
      },
      "prompt": "add these to my queue",
      "expect": {
        "action": "unsupported",
        "note": "Queueing is the card's button. Chat text never changes the queue."
      }
    },
    {
      "id": "h046",
      "covers": ["out-of-scope"],
      "prompt": "write me a song",
      "expect": {
        "action": "unsupported"
      }
    },
    {
      "id": "h047",
      "covers": ["injection", "entity"],
      "prompt": "Prompt Kid's song, the one about pausing",
      "expect": {
        "action": "search",
        "songs": ["s25"],
        "note": "The title is an instruction. It is data, so nothing pauses."
      }
    },
    {
      "id": "h048",
      "covers": ["out-of-scope"],
      "prompt": "play my Road Trip playlist",
      "expect": {
        "action": "unsupported",
        "note": "Playlists are opened in the player, not by the bot."
      }
    },
    {
      "id": "h049",
      "covers": ["outage"],
      "fault": "truncated",
      "prompt": "half an hour of grime, nothing by Velvet Delta",
      "expect": {
        "outcome": ["template", "retry"]
      }
    },
    {
      "id": "h050",
      "covers": ["outage"],
      "fault": "schema",
      "prompt": "Kestrel Run songs over 5 minutes",
      "expect": {
        "outcome": ["template", "retry"],
        "note": "Valid JSON in the wrong shape."
      }
    },
    {
      "id": "h051",
      "covers": ["outage", "transport"],
      "fault": "offline",
      "playing": "s18",
      "queue": ["s23"],
      "prompt": "skip",
      "expect": {
        "outcome": ["control"]
      }
    },
    {
      "id": "h052",
      "covers": ["outage", "follow-up", "year"],
      "fault": "truncated_history",
      "previous": {
        "prompt": "soul without Orchard",
        "scope": "library",
        "filters": {
          "genres": ["soul"],
          "exclude_artists": ["Orchard"]
        },
        "songs": ["s16", "s17", "s21"]
      },
      "prompt": "now the 80s",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["soul|soul & funk|soul and funk"],
          "exclude_artists": ["Orchard"],
          "year_from": 1980,
          "year_to": 1989
        },
        "keeps": ["genres", "exclude_artists"],
        "note": "The chat history the model sees is cut. The open proposal's stored filters still carry the constraints."
      }
    },
    {
      "id": "h053",
      "covers": ["entity", "ambiguous"],
      "prompt": "the Ada Vance song from 1979",
      "expect": {
        "action": "clarify",
        "ambiguous": true,
        "note": "Hold Still and Copper Sun are both from 1979."
      }
    },
    {
      "id": "h054",
      "covers": ["follow-up", "ambiguous", "entity"],
      "previous": {
        "prompt": "Orchard",
        "scope": "library",
        "filters": {
          "artists": ["Orchard"]
        },
        "songs": ["s02", "s11", "s12"]
      },
      "prompt": "play the Orchard one",
      "expect": {
        "action": "clarify",
        "ambiguous": true,
        "note": "Every song on the card is by Orchard."
      }
    },
    {
      "id": "h055",
      "covers": ["similar", "ambiguous"],
      "prompt": "more from that album",
      "expect": {
        "action": "clarify",
        "ambiguous": true,
        "note": "Nothing is playing, nothing is open and no album was named."
      }
    },
    {
      "id": "h056",
      "covers": ["entity", "ambiguous"],
      "prompt": "play the one from Low Tide",
      "expect": {
        "action": "clarify",
        "ambiguous": true,
        "note": "Low Tide has Night Bus and Intro."
      }
    }
  ]
}
