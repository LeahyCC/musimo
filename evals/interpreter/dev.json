      "prompt": "The Blues Engine please",
      "expect": {
        "action": "search",
        "filters": {
          "artists": ["The Blues Engine"]
        },
        "note": "An artist whose name holds a genre word. genres stays empty."
      }
    },
    {
      "id": "d003",
      "covers": ["genre"],
      "prompt": "some blues",
      "expect": {
        "action": "search",
        "filters": {
          "genres": ["blues"]
        }
      }
    },
