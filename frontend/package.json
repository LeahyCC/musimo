{
  "name": "musimo-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "test:visualizer": "playwright test --config playwright.visualizer.config.ts",
    "test:director": "node --test tests/visualizer-director.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project tsconfig.e2e.json",
    "test:e2e:report": "playwright show-report",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --ignore-path ../.prettierignore --write ..",
    "format:check": "prettier --ignore-path ../.prettierignore --check ..",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
