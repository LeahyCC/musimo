# Copy to .env to override deployment defaults.
MUSIMO_BIND=127.0.0.1
MUSIMO_PORT=8765
PUID=1000
PGID=1000
# Use poll for Windows Docker Desktop or network mounts without filesystem events.
MUSIMO_WATCH_MODE=native
MUSIMO_POLL_INTERVAL_SECONDS=300
# Deezer arl cookie for the first start. Musimo moves it into data/deezer-arl.txt, and
# Settings replaces or removes it after that. Leave empty for YouTube.
MUSIMO_DEEZER_ARL=
# Search catalog for the first start: deezer (default) or spotify. Blank leaves Deezer.
MUSIMO_SEARCH_CATALOG=
# Spotify developer app for the first start. The owner needs Spotify Premium.
# Musimo moves the pair into data/spotify-app.json. The secret is not shown again.
MUSIMO_SPOTIFY_CLIENT_ID=
MUSIMO_SPOTIFY_CLIENT_SECRET=
# Secret shared by Musimo and the optional audio worker (docker compose --profile analysis).
# Any long random string. Empty keeps the worker's lease routes off.
MUSIMO_ANALYSIS_TOKEN=
